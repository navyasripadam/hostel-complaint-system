<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Complaint Details</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <%- include("../includes/navbar") %>
    <%- include("../includes/flash") %>

   <div class="container mt-4 position-relative">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Complaint Details</h2>

            <a href="/admin/complaints" class="position-absolute top-0 end-0 me-3 text-decoration-none"
            title="Complaint Details"
            style="font-size: 24px;" >
               <i class="fa-solid fa-arrow-left" style="color: #003b73;"></i>
            </a>
        </div>

        <div class="card shadow">
            <div class="card-body">

                <h4 class="mb-3">
                    <%= complaint.title %>
                </h4>

                <p>
                    <strong>Description:</strong>
                    <%= complaint.description %>
                </p>

                <p>
                    <strong>Category:</strong>
                    <%= complaint.category %>
                </p>

                <p>
                    <strong>Status:</strong>

                    <% if (complaint.status === "Pending") { %>
                        <span class="badge bg-warning text-dark">Pending</span>
                    <% } %>

                    <% if (complaint.status === "In Progress") { %>
                        <span class="badge bg-primary">In Progress</span>
                    <% } %>

                    <% if (complaint.status === "Resolved") { %>
                        <span class="badge bg-success">Resolved</span>
                    <% } %>

                    <% if (complaint.status === "Rejected") { %>
                        <span class="badge bg-danger">Rejected</span>
                    <% } %>
                </p>

                <hr>

                <h5 class="mb-3">Student Information</h5>

                <p>
                    <strong>Name:</strong>
                    <%= complaint.student.name %>
                </p>

                <p>
                    <strong>Email:</strong>
                    <%= complaint.student.email %>
                </p>

                <p>
                    <strong>Hostel:</strong>
                    <%= complaint.hostel %>
                </p>

                <p>
                    <strong>Room Number:</strong>
                    <%= complaint.roomNumber %>
                </p>

                <hr>

                <% if (complaint.createdAt) { %>
                    <p class="text-muted small">
                        Submitted:
                        <%= complaint.createdAt.toLocaleString() %>
                    </p>
                <% } %>

                <% if (complaint.updatedAt) { %>
                    <p class="text-muted small">
                        Last Updated:
                        <%= complaint.updatedAt.toLocaleString() %>
                    </p>
                <% } %>

            </div>
        </div>

    </div>

</body>
</html>