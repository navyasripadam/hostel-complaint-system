<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Hostel Complaint</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous">


        <link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

</head>

<body>

    <%- include("../includes/navbar") %>
    <%- include("../includes/flash") %>


    <!-- Search / Filter / Sort -->

    <div class="container mt-4">

        <form action="/admin/complaints" method="GET" class="row g-2 mb-4">

            <div class="col-md-4">

                <input
                    type="text"
                    name="search"
                    class="form-control"
                    placeholder="Search by title, hostel, room or student">

            </div>


            <div class="col-md-3">

                <select name="status" class="form-select">

                    <option value="">
                        All Complaints
                    </option>

                    <option value="Pending">
                        Pending
                    </option>

                    <option value="In Progress">
                        In Progress
                    </option>

                    <option value="Resolved">
                        Resolved
                    </option>

                    <option value="Rejected">
                        Rejected
                    </option>

                </select>

            </div>


            <div class="col-md-2">

                <button class="btn btn-primary w-100">
                    Search
                </button>

            </div>


            <div class="col-md-3 d-flex justify-content-end">

    <button
        type="submit"
        name="sort"
        value="<%= sort === 'oldest' ? 'newest' : 'oldest' %>"
        class="btn"
        title="Sort">

        <i class="fa-solid fa-sort" style="color: #003b73;"></i>

    </button>

</div>

        </form>


        <!-- Dashboard Statistics -->

        <div class="row g-3">

            <div class="col-md">

                <div class="card text-center bg-primary text-white shadow">

                    <div class="card-body">

                        <h5>Total</h5>

                        <h2>
                            <%= total %>
                        </h2>

                    </div>

                </div>

            </div>


            <div class="col-md">

                <div class="card text-center bg-warning shadow">

                    <div class="card-body">

                        <h5>Pending</h5>

                        <h2>
                            <%= pending %>
                        </h2>

                    </div>

                </div>

            </div>


            <div class="col-md">

                <div class="card text-center bg-info text-white shadow">

                    <div class="card-body">

                        <h5>In Progress</h5>

                        <h2>
                            <%= inProgress %>
                        </h2>

                    </div>

                </div>

            </div>


            <div class="col-md">

                <div class="card text-center bg-success text-white shadow">

                    <div class="card-body">

                        <h5>Resolved</h5>

                        <h2>
                            <%= resolved %>
                        </h2>

                    </div>

                </div>

            </div>


            <div class="col-md">

                <div class="card text-center bg-danger text-white shadow">

                    <div class="card-body">

                        <h5>Rejected</h5>

                        <h2>
                            <%= rejected %>
                        </h2>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Charts -->

    <div class="container mt-4">

        <div class="row">

            <div class="col-md-4">

                <select id="chartSelector" class="form-select">

                    <option value="">
                        Visualize Complaints By
                    </option>

                    <option value="status">
                         Status
                    </option>

                    <option value="category">
                         Category
                    </option>

                </select>

            </div>

        </div>


        <!-- Status Chart -->

        <div
            id="statusChartContainer"
            class="mt-3"
            style="display: none;">

            <div
                class="card shadow p-3"
                style="height: 350px;">

                <h5 class="text-center mb-3">
                    Complaints by Status
                </h5>

                <div
                    style="position: relative; height: 270px;">

                    <canvas id="statusChart"></canvas>

                </div>

            </div>

        </div>


        <!-- Category Chart -->

        <div
            id="categoryChartContainer"
            class="mt-3"
            style="display: none;">

            <div
                class="card shadow p-3"
                style="height: 350px;">

                <h5 class="text-center mb-3">
                    Complaints by Category
                </h5>

                <div
                    style="position: relative; height: 270px;">

                    <canvas id="categoryChart"></canvas>

                </div>

            </div>

        </div>

    </div>


    <!-- Complaint Cards -->

    <div class="container mt-4">

        <div class="row">

            <% complaints.forEach((complaint) => { %>

                <div class="col-md-4 mb-2">

                    <div class="card shadow h-100 w-100">

                        <div class="card-body">

                            <h4 class="card-title">
                                <%= complaint.title %>
                            </h4>


                            <p>

                                <strong>Name: </strong>

                                <strong>
                                    <%= complaint.student.name %>
                                </strong>

                            </p>


                            <p>

                                <strong>Description: </strong>

                                <%= complaint.description %>

                            </p>


                            <p>

                                <strong>Category: </strong>

                                <%= complaint.category %>

                            </p>


                            <p>

                                <strong>Hostel: </strong>

                                <%= complaint.hostel %>

                            </p>


                            <p>

                                <strong>Room: </strong>

                                <%= complaint.roomNumber %>

                            </p>


                            <p>

                                <strong>Status: </strong>


                                <% if (complaint.status === "Pending") { %>

                                    <span class="badge bg-warning">
                                        Pending
                                    </span>

                                <% } %>


                                <% if (complaint.status === "Resolved") { %>

                                    <span class="badge bg-success">
                                        Resolved
                                    </span>

                                <% } %>


                                <% if (complaint.status === "In Progress") { %>

                                    <span class="badge bg-info">
                                        In Progress
                                    </span>

                                <% } %>


                                <% if (complaint.status === "Rejected") { %>

                                    <span class="badge bg-secondary">
                                        Rejected
                                    </span>

                                <% } %>

                            </p>


                            <!-- View Details -->

                            <a
                                href="/admin/complaints/<%= complaint._id %>"
                                class="text-decoration-none"
                                style="color: #003b73;">

                                View Details

                            </a>


                            &nbsp;&nbsp;&nbsp;


                            <!-- Edit Status -->

                            <a
                                href="/admin/complaints/<%= complaint._id %>/edit"
                                class="btn btn-danger btn-sm">

                                Edit Status

                            </a>

                        </div>

                    </div>

                </div>

            <% }); %>

        </div>

    </div>


    <!-- Bootstrap JS -->

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForClyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous">
    </script>


    <!-- Chart JavaScript -->

    <script>

        let statusChartInstance = null;
        let categoryChartInstance = null;


        document
            .getElementById("chartSelector")
            .addEventListener("change", function () {

                const selectedValue = this.value;

                const statusContainer =
                    document.getElementById("statusChartContainer");

                const categoryContainer =
                    document.getElementById("categoryChartContainer");


                // Hide both charts

                statusContainer.style.display = "none";

                categoryContainer.style.display = "none";


                // If nothing is selected

                if (selectedValue === "") {

                    return;

                }


                // =========================
                // STATUS CHART
                // =========================

                if (selectedValue === "status") {

                    statusContainer.style.display = "block";


                    if (statusChartInstance) {

                        statusChartInstance.destroy();

                    }


                    statusChartInstance = new Chart(

                        document.getElementById("statusChart"),

                        {

                            type: "doughnut",

                            data: {

                                labels: [
                                    "Pending",
                                    "In Progress",
                                    "Resolved",
                                    "Rejected"
                                ],

                                datasets: [{

                                    data: [

                                        <%= pending %>,

                                        <%= inProgress %>,

                                        <%= resolved %>,

                                        <%= rejected %>

                                    ]

                                }]

                            },

                            options: {

                                responsive: true,

                                maintainAspectRatio: false

                            }

                        }

                    );

                }


                // =========================
                // CATEGORY CHART
                // =========================

                if (selectedValue === "category") {

                    categoryContainer.style.display = "block";


                    if (categoryChartInstance) {

                        categoryChartInstance.destroy();

                    }


                    categoryChartInstance = new Chart(

                        document.getElementById("categoryChart"),

                        {

                            type: "bar",

                            data: {

                                labels:
                                    <%- JSON.stringify(categories) %>,

                                datasets: [{

                                    label: "Complaints",

                                    data:
                                        <%- JSON.stringify(categoryCounts) %>

                                }]

                            },

                            options: {

                                responsive: true,

                                maintainAspectRatio: false,

                                scales: {

                                    y: {

                                        beginAtZero: true,

                                        ticks: {

                                            stepSize: 1

                                        }

                                    }

                                }

                            }

                        }

                    );

                }

            });

    </script>


</body>

</html>