<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hostel Complaint</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body>
    <%- include("../includes/navbar")%>
    <%-include("../includes/flash")%>



    <div class="container mt-4">
         <form action="/admin/complaints" method="GET" class="row g-2 mb-4">
            <div class="col-md-4">
                <input type="text" name="search" class="form-control" placeholder="Search by title or room number">
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All Complaints</option>
                    <option value="Pending">Pending</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Resolved">Resolved</option>
                    <option value="Rejected">Rejected</option>
                </select>
            </div>

            <div class="col-md-2">
                <button class="btn btn-primary w-100">Search</button>
            </div>
            <div class="col-md-3">
                <select name="sort" class="form-select">
                    <option value="newest">Newest First</option>
                    <option value="oldest">Oldest First</option>
                </select>
            </div>
         </form>


        <div class="row g-3">
            <div class="col-md">
                <div class="card text-center bg-primary text-white shadow">
                    <div class="card-body">
                        <h5>Total</h5>
                        <h2><%=total%></h2>
                    </div>
                </div>
            </div>
             <div class="col-md">
                <div class="card text-center bg-warning shadow">
                    <div class="card-body">
                        <h5>Pending</h5>
                        <h2><%=pending%></h2>
                    </div>
                </div>
            </div>
             <div class="col-md">
                <div class="card text-center bg-info text-white shadow">
                    <div class="card-body">
                        <h5>In Progress</h5>
                        <h2><%=inProgress%></h2>
                    </div>
                </div>
            </div>
             <div class="col-md">
                <div class="card text-center bg-success text-white shadow">
                    <div class="card-body">
                        <h5>Resolved</h5>
                        <h2><%=resolved%></h2>
                    </div>
                </div>
            </div>
             <div class="col-md">
                <div class="card text-center bg-danger text-white shadow">
                    <div class="card-body">
                        <h5>Rejected</h5>
                        <h2><%=rejected%></h2>
                    </div>
                </div>
            </div>
            </div>
    </div>
    <div class="container mt-4">
        <div class="row">
    <%complaints.forEach((complaint)=>{%>
        <div class="col-md-4 mb-2">
        <div class="card shadow h-100 w-100">
        <div class="card-body">
            <h4 class="card-title"><%=complaint.title%></h4>
             <p><strong>Name: </strong><strong><%=complaint.student.name%></strong></p>
            <p><strong>Description: </strong><%=complaint.description%></p>
            <p><strong>Category: </strong><%=complaint.category%></p>
            <p><strong>Room: </strong><%=complaint.roomNumber%></p>
             <p><strong>Status: </strong>
                <%if(complaint.status==="Pending"){%>
                    <span class="badge bg-warning">Pending</span>
                <%}%>
                <%if(complaint.status==="Resolved"){%>
                    <span class="badge bg-success">Resolved</span>
                <%}%>
                 <%if(complaint.status==="In Progress"){%>
                    <span class="badge bg-info">In Progress</span>
                <%}%>
                <%if(complaint.status==="Rejected"){%>
                    <span class="badge bg-secondary">Rejected</span>
                <%}%>
            </p>
           <a href="/admin/complaints/<%=complaint._id%>/edit" class="btn btn-danger btn-sm">Edit Status</a>
           </div>
           </div>
           </div>
    <%});%>
        </div>
        </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>










