<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
</head>
<body>
    <%-include("../includes/navbar")%>
    <%-include("../includes/flash")%>
    <div class="container mt-4 position-relative">
        <a href="/complaints/history"
            class="position-absolute top-0 end-0 me-3 text-decoration-none"
            title="Complaint History"
            style="font-size: 24px;">
                <i class="fa-solid fa-clock-rotate-left" style="color: #003b73;" font-size: 24px;></i>
        </a>
    
<% if (allComplaints.length === 0) { %>

    <div class="text-center mt-5">

        <h4>No Active Complaints</h4>

        <p class="text-muted">
            You don't have any pending or in-progress complaints.
        </p>

        <a href="/complaints/new" class="btn btn-primary">
            Raise a New Complaint
        </a>

    </div>

<% } else { %>

    <div class="row">

        <% allComplaints.forEach((complaint)=>{ %>
            <div class="col-md-4 mb-2">
            <div class="card shadow h-100 w-100">
            <div class="card-body">
                <h4 class="card-title"><%=complaint.title%></h4>
                <p><strong>Description: </strong><%=complaint.description%></p>
                <p><strong>Category: </strong><%=complaint.category%></p>
                <p><strong>Hostel: </strong><%=complaint.hostel%></p>
                <p><strong>Room: </strong><%=complaint.roomNumber%></p>
                <p><strong>Status: </strong>
                    <%if(complaint.status==="Pending"){%>
                        <span class="badge bg-warning">Pending</span>
                    <%}%>
                    <%if(complaint.status==="Resolved"){%>
                        <span class="badge bg-success">Resolved</span>
                    <%}%>
                    <%if(complaint.status==="In Progress"){%>
                        <span class="badge bg-info">In Progress</span>
                    <%}%>
                    <%if(complaint.status==="Rejected"){%>
                        <span class="badge bg-danger">Rejected</span>
                    <%}%>
                </p>
                     <% if (complaint.createdAt) { %>
    <p class="text-muted small">
       <strong> Submitted: </strong><%= complaint.createdAt.toLocaleString() %>
    </p>
<% } %>
                <a href="/complaints/<%=complaint._id%>/edit" class="btn btn-warning btn-sm">Edit</a>
                <form action="/complaints/<%=complaint._id%>?_method=DELETE" method="post" class="d-inline">
                    <button class="btn btn-danger btn-sm">Delete</button>
            </form>
            </div>
            </div>
        </div>
           
        <% }); %>

    </div>

<% } %>
      </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>





           
         
  