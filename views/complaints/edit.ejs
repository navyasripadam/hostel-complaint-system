<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body>
    <%-include("../includes/navbar")%>
      <%-include("../includes/flash")%>
    
       <div class="conatiner vh-100 d-flex justify-content-center align-items-center">
            <div class="row w-100 justify-content-center">
                 <div class="col-md-4">
                     <div class="card shadow">
                         <div class="card-header bg-primary text-white text-center">
                            <h3>Edit Complaint</h3>
                         </div>
                         <div class="card-body">
        <form action="/complaints/<%=complaint._id%>?_method=PUT" method="post">
            <input class="form-control mb-3" type="text" placeholder="Ex:Fan is not working" name="title" value="<%=complaint.title%>">
            <textarea class="form-control mb-3" type="text" placeholder="Describe your issue" name="description"><%=complaint.description%></textarea>
            <div class="row">
                <div class="col-md-6">
                    <select class="form-select mb-3"  name="category" value="<%=complaint.category%>">
                        <option value="electrical">Electrical</option>
                        <option value="plumbing">Plumbing</option>
                        <option value="civil">Civil Works</option>
                        <option value="wifi">WIFI</option>
                        <option value="others">Others</option>
                    </select>
                </div>
                <div class="col-md-6"><input class="form-control" type="text" name="roomNumber" value="<%=complaint.roomNumber%>"></div>
            </div>
            <button class="btn btn-primary w-100" type="submit">Edit Complaint</button>
        </form>
         </div>
    </div>
    </div>
    </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>