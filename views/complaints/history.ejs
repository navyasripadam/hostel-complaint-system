<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Complaint History</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <%- include("../includes/navbar") %>
    <%- include("../includes/flash") %>

    <div class="container mt-4">

        <h2 class="mb-4">Complaint History</h2>

        <% if (historyComplaints.length === 0) { %>

            <div class="text-center mt-5">
                <h5>No Complaint History</h5>
                <p class="text-muted">
                    Your resolved or rejected complaints will appear here.
                </p>
            </div>

        <% } else { %>

            <div class="row">

                <% historyComplaints.forEach((complaint) => { %>

                    <div class="col-md-4 mb-3">

                        <div class="card shadow h-100">

                            <div class="card-body">

                                <h4><%= complaint.title %></h4>

                                <p>
                                    <strong>Description:</strong>
                                    <%= complaint.description %>
                                </p>

                                <p>
                                    <strong>Category:</strong>
                                    <%= complaint.category %>
                                </p>

                                <p>
                                    <strong>Hostel:</strong>
                                    <%= complaint.hostel %>
                                </p>

                                <p>
                                    <strong>Room:</strong>
                                    <%= complaint.roomNumber %>
                                </p>

                                <p>
                                    <strong>Status:</strong>

                                    <% if (complaint.status === "Resolved") { %>
                                        <span class="badge bg-success">
                                            Resolved
                                        </span>
                                    <% } %>

                                    <% if (complaint.status === "Rejected") { %>
                                        <span class="badge bg-danger">
                                            Rejected
                                        </span>
                                    <% } %>

                                </p>
                                  <% if (complaint.createdAt) { %>
    <p class="text-muted small">
       <strong> Submitted: </strong><%= complaint.createdAt.toLocaleString() %>
    </p>
<% } %>

                            </div>

                        </div>

                    </div>

                <% }); %>

            </div>

        <% } %>

    </div>

</body>
</html>